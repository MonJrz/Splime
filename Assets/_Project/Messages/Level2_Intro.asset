    _speaker: 1
  - _title:
    _body: We're slimes.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: So?
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: Remember the puddle incident?
    _illustration: {fileID: 0}
    _speaker: 0
