MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 476ad496359b44358d3a4fd321ce1218, type: 3}
  m_Name: Level1_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Splime.UI.UIMessageSequence
  _canSkip: 1
  _leftParticipant:
    _name: Orange
    _portrait: {fileID: 21300000, guid: 312cd6597f9a5354183398155c754e76, type: 3}
  _rightParticipant:
    _name: Blue
    _portrait: {fileID: 21300000, guid: 8a57a8d0a2a7f5642aad0562ecf1cf16, type: 3}
  _pages:
  - _title:
    _body: Hey Blue! Come on. We need berries.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: No can do. Very important business.
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: You're napping.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: I'm recharging.
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: You don't have batteries.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: Not with that attitude.
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: Look, I can't get to the berries without you.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: And skip my beauty sleep? Ha! That's how you get wrinkles.
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: ...Do slimes even get wrinkles?
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: I'm not taking that risk.
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: Fine. Stay here. More antioxidant-rich berries for me.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: ...Antioxidant-rich?
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: Mhm. Good for your skin.
    _illustration: {fileID: 0}
    _speaker: 0
  - _title:
    _body: WHY ARE WE STILL HERE?!
    _illustration: {fileID: 0}
    _speaker: 1
  - _title:
    _body: TO THE BERRIES!
    _illustration: {fileID: 0}
    _speaker: 1
